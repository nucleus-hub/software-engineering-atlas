<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.atlas</groupId>
        <artifactId>pocs</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>spark</artifactId>
    <name>POC :: Spark</name>
    <description>Apache Spark batch and SQL experiments.</description>

    <properties>
        <!-- Spark 3.5.x officially targets Java 8/11/17. If you hit issues on
             Java 21, run this POC with a JDK 17 toolchain. -->
        <spark.version>3.5.3</spark.version>
        <scala.binary.version>2.13</scala.binary.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-core_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
        </dependency>
    </dependencies>
</project>
